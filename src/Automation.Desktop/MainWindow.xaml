<Window x:Class="Automation.Desktop.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:viewModels="clr-namespace:Automation.Desktop.ViewModels"
        xmlns:views="clr-namespace:Automation.Desktop.Views"
        mc:Ignorable="d"
        Title="Globalsoft Automation"
        Width="1120"
        Height="720"
        MinWidth="920"
        MinHeight="560"
        WindowStartupLocation="CenterScreen"
        Background="#F4F6FA">
    <Window.Resources>
        <DataTemplate DataType="{x:Type viewModels:AutomationCatalogViewModel}">
            <views:AutomationCatalogView />
        </DataTemplate>

        <Style x:Key="NavigationButtonStyle" TargetType="RadioButton">
            <Setter Property="Height" Value="48" />
            <Setter Property="Margin" Value="12,4" />
            <Setter Property="Padding" Value="16,0" />
            <Setter Property="HorizontalContentAlignment" Value="Left" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="FontSize" Value="15" />
            <Setter Property="Foreground" Value="#42526E" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="NavigationBackground"
                                Padding="{TemplateBinding Padding}"
                                Background="{TemplateBinding Background}"
                                CornerRadius="8">
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalAlignment="{TemplateBinding VerticalContentAlignment}" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="NavigationBackground" Property="Background" Value="#EEF3FF" />
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="NavigationBackground" Property="Background" Value="#E4ECFF" />
                                <Setter Property="Foreground" Value="#244AA5" />
                                <Setter Property="FontWeight" Value="SemiBold" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.62" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="244" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <Border Grid.Column="0"
                Background="White"
                BorderBrush="#E2E7F0"
                BorderThickness="0,0,1,0">
            <DockPanel LastChildFill="True">
                <StackPanel DockPanel.Dock="Top" Margin="28,28,20,24">
                    <TextBlock FontSize="20"
                               FontWeight="Bold"
                               Foreground="#172B4D"
                               Text="Globalsoft" />
                    <TextBlock Margin="0,3,0,0"
                               FontSize="13"
                               Foreground="#6B778C"
                               Text="Automation Platform" />
                </StackPanel>

                <StackPanel>
                    <TextBlock Margin="28,0,0,8"
                               FontSize="11"
                               FontWeight="SemiBold"
                               Foreground="#8993A4"
                               Text="เมนู"
                               TextWrapping="Wrap" />
                    <RadioButton AutomationProperties.AutomationId="AutomationsNavigation"
                                 Content="Automations"
                                 GroupName="PlatformNavigation"
                                 IsChecked="True"
                                 Style="{StaticResource NavigationButtonStyle}" />
                    <RadioButton AutomationProperties.AutomationId="AccountsNavigation"
                                 Content="บัญชีผู้ใช้"
                                 GroupName="PlatformNavigation"
                                 IsEnabled="False"
                                 Style="{StaticResource NavigationButtonStyle}"
                                 ToolTip="ยังไม่พร้อมใช้งาน" />
                    <RadioButton AutomationProperties.AutomationId="SystemSettingsNavigation"
                                 Content="ตั้งค่าระบบ"
                                 GroupName="PlatformNavigation"
                                 IsEnabled="False"
                                 Style="{StaticResource NavigationButtonStyle}"
                                 ToolTip="ยังไม่พร้อมใช้งาน" />
                </StackPanel>
            </DockPanel>
        </Border>

        <ContentControl Grid.Column="1"
                        AutomationProperties.AutomationId="MainContent"
                        Content="{Binding AutomationCatalog}" />
    </Grid>
</Window>

<UserControl x:Class="Automation.Desktop.Views.AutomationCatalogView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             d:DesignHeight="720"
             d:DesignWidth="876"
             mc:Ignorable="d">
    <ScrollViewer HorizontalScrollBarVisibility="Disabled"
                  VerticalScrollBarVisibility="Auto">
        <Grid Margin="48,42">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <StackPanel>
                <TextBlock AutomationProperties.AutomationId="PageTitle"
                           FontSize="30"
                           FontWeight="Bold"
                           Foreground="#172B4D"
                           Text="Automations" />
                <TextBlock Margin="0,8,0,0"
                           FontSize="15"
                           Foreground="#6B778C"
                           Text="เลือก Automation ที่ต้องการใช้งาน"
                           TextWrapping="Wrap" />
            </StackPanel>

            <Grid Grid.Row="1" Margin="0,36,0,0">
                <Border x:Name="EmptyState"
                        AutomationProperties.AutomationId="EmptyCatalogState"
                        MaxWidth="560"
                        Padding="48"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Background="White"
                        BorderBrush="#DDE3ED"
                        BorderThickness="1"
                        CornerRadius="14">
                    <StackPanel HorizontalAlignment="Center">
                        <Border Width="64"
                                Height="64"
                                HorizontalAlignment="Center"
                                Background="#EEF3FF"
                                CornerRadius="32">
                            <TextBlock HorizontalAlignment="Center"
                                       VerticalAlignment="Center"
                                       FontSize="28"
                                       Foreground="#3157B7"
                                       Text="⚙" />
                        </Border>
                        <TextBlock Margin="0,22,0,0"
                                   HorizontalAlignment="Center"
                                   FontSize="19"
                                   FontWeight="SemiBold"
                                   Foreground="#172B4D"
                                   Text="ยังไม่มี Automation ที่พร้อมใช้งาน"
                                   TextAlignment="Center"
                                   TextWrapping="Wrap" />
                        <TextBlock Margin="0,10,0,0"
                                   HorizontalAlignment="Center"
                                   FontSize="14"
                                   Foreground="#6B778C"
                                   Text="Automation ที่ลงทะเบียนจะแสดงในหน้านี้"
                                   TextAlignment="Center"
                                   TextWrapping="Wrap" />
                    </StackPanel>
                    <Border.Style>
                        <Style TargetType="Border">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsEmpty}" Value="True">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                </Border>

                <ItemsControl x:Name="AutomationCards"
                              AutomationProperties.AutomationId="AutomationCards"
                              ItemsSource="{Binding Automations}">
                    <ItemsControl.Style>
                        <Style TargetType="ItemsControl">
                            <Setter Property="Visibility" Value="Visible" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsEmpty}" Value="True">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </ItemsControl.Style>
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Width="310"
                                    MinHeight="176"
                                    Margin="0,0,20,20"
                                    Padding="24"
                                    Background="White"
                                    BorderBrush="#DDE3ED"
                                    BorderThickness="1"
                                    CornerRadius="12">
                                <StackPanel>
                                    <Border Width="48"
                                            Height="48"
                                            HorizontalAlignment="Left"
                                            Background="#EEF3FF"
                                            CornerRadius="10">
                                        <TextBlock HorizontalAlignment="Center"
                                                   VerticalAlignment="Center"
                                                   FontSize="20"
                                                   Foreground="#3157B7"
                                                   Text="{Binding IconKey}" />
                                    </Border>
                                    <TextBlock Margin="0,18,0,0"
                                               FontSize="18"
                                               FontWeight="SemiBold"
                                               Foreground="#172B4D"
                                               Text="{Binding DisplayName}"
                                               TextWrapping="Wrap" />
                                    <TextBlock Margin="0,6,0,0"
                                               FontSize="12"
                                               Foreground="#8993A4"
                                               Text="{Binding ModuleId}"
                                               TextWrapping="Wrap" />
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </Grid>
        </Grid>
    </ScrollViewer>
</UserControl>
